          WL_2_2->wilsonLineUpdate(*su3_2_2, tmp, 4 + Bdir2);
        }
        for(int bi = 0; bi < b; bi++) {
          su3_exchange = su3_in; su3_in = WL_4_1; WL_4_1 = su3_exchange;
