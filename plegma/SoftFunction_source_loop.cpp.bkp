          corrqwf.writeFile((qwf_filename+".Bdir_"+std::to_string(Bdir2)+"_tsrc_"+std::to_string(tsrci)+"_stout_"+std::to_string(nStout)+".h5").c_str(), corr_file_format);
          for(int bi = 0; bi < b; bi++) {
