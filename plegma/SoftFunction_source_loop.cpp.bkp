  //negative L, positive B

  for(int l:Lvals) {//loop over values of L
    //absorb the gauge directions for building the 4 branches
    su3_1->absorbDir_device(gaugeWL, WilsDir);
    su3_2_1->absorbDir_device(gaugeWL, Bdir1);
